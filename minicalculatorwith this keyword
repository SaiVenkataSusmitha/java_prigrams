import java.util.Scanner;

class Calculator {
    int n1, n2;

    Calculator(int n1, int n2) {
        this.n1 = n1;
        this.n2 = n2;
    }

    void calculate(char op) {
        switch (op) {
            case '+':
                System.out.println("Addition = " + (this.n1 + this.n2));
                break;

            case '-':
                System.out.println("Subtraction = " + (this.n1 - this.n2));
                break;

            case '*':
                System.out.println("Multiplication = " + (this.n1 * this.n2));
                break;

            case '/':
                System.out.println("Division = " + (this.n1 / this.n2));
                break;

            default:
                System.out.println("Invalid operator");
        }
    }
}

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter first number: ");
        int a = sc.nextInt();

        System.out.print("Enter second number: ");
        int b = sc.nextInt();

        System.out.print("Enter operator (+, -, *, /): ");
        char op = sc.next().charAt(0);

        Calculator c = new Calculator(a, b);
        c.calculate(op);
    }
}
