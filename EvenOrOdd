import java.util.Scanner;
public class EvenOrOdd {
    public static void main(String[] args) {
        Scanner sc=newScanner(System.in);
        System.out.println();
        int number = sc.nextInt();

        String evenOrOdd = (number % 2 == 0) ? "Even" : "Odd";

        System.out.println(evenOrOdd);
    }
}
